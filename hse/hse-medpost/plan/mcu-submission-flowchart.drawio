<mxfile host="app.diagrams.net">
  <diagram id="mcu-submission-flow" name="MCU submission flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Phase headings -->
        <mxCell id="h1" value="1. Submitter account" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="h2" value="2. Batch and upload" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="h3" value="3. Staff review and after" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="0" width="300" height="30" as="geometry"/></mxCell>

        <!-- Column A: account -->
        <mxCell id="a1" value="Open /mcu-submit (public landing page)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="a2" value="Register: name, email, company (pick only), position + Turnstile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="a3" value="Verification email sent. Page gives the same reply whether or not the email exists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="a4" value="Link opened within 48 h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="a4n" value="Request purged" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="350" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="a5" value="Admins emailed. Request waits in the Admin queue (Requested)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="a6" value="Portal admin approves?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="a6n" value="Rejected. Reason emailed to the submitter" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="575" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="a7" value="Approval email with one-time setup link (valid 3 days)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="a8" value="Submitter picks username + password. Account becomes Active" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="a9" value="Sign in: username, password, Turnstile (5 wrong passwords lock 15 min)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="240" height="60" as="geometry"/></mxCell>

        <!-- Column B: batch and upload -->
        <mxCell id="b1" value="New batch: enter one worker (name, birth date, position, company, nationality, NIK or passport)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="b2" value="Match patient: NIK or passport first, then name + birth date. No match = new employee (snapshot only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="b3" value="Upload one PDF for that worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="b4" value="Upload pipeline: up to 15 MB, starts with %PDF-, not encrypted, Ghostscript rebuild, shrink to 2 MB, structure check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="b5" value="Pipeline passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="b5n" value="Rejected with a message. No file or row kept" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="850" y="490" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="b6" value="Saved as Draft. Staff cannot see it; submitter can remove it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="b7" value="Add another worker?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="b8" value="Press Send for review and confirm. Batch is locked, documents become Pending" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="820" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="b9" value="Mail goes out once per batch: one to reviewers, one to the submitter. Retry every 15 min if SMTP fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="910" width="240" height="70" as="geometry"/></mxCell>

        <!-- Column C: staff review -->
        <mxCell id="c1" value="Staff review queue (Pending documents only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="Submitter withdraws while still Pending?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="c2y" value="Withdrawn. PDF deleted, row kept as audit stub" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1360" y="155" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c3" value="Staff opens the PDF (logged), links or creates the Patient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="275" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="Staff accepts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1100" y="375" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c4n" value="Rejected with a reason. Submitter sees it in My submissions" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1360" y="385" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c5" value="Mark Reviewed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="495" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="c6" value="Create the McuRecord from it. Status becomes Closed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="585" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c7" value="Daily jobs: delete PDFs after 2 years; mail expiring-checkup reminders to submitters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="685" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="c8" value="Done" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1080" y="795" width="240" height="40" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="l0" value="Legend" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="880" width="80" height="24" as="geometry"/></mxCell>
        <mxCell id="l1" value="Submitter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="910" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="l2" value="Portal admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1190" y="910" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="l3" value="System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1300" y="910" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="l4" value="Medpost staff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1410" y="910" width="100" height="30" as="geometry"/></mxCell>

        <!-- Edges: account -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a4n"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a6" target="a6n"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a9" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="920"/><mxPoint x="525" y="75"/></Array></mxGeometry></mxCell>

        <!-- Edges: batch -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b5" target="b5n"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="Yes (next worker)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="740"/><mxPoint x="825" y="75"/></Array></mxGeometry></mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="945"/><mxPoint x="1045" y="70"/></Array></mxGeometry></mxCell>

        <!-- Edges: review -->
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c2y"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g6" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c4n"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
