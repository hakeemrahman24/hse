# Copy to .env on the Pi (never commit .env). Business numbers are NOT here:
# they live in the Settings page. Only deployment facts and secrets go here.
PORT=8114
BASE_URL=https://permit.example.invalid

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=entry_permit_user
DB_PASSWORD=change-me
DB_NAME=entry_permit

# Dev only (DB_DRIVER=sqlite): DATABASE_PATH=./data/entry_permit.db
UPLOAD_DIR=/mnt/data/projects/entry-permit/uploads
SESSION_SECRET=change-me-to-a-long-random-string

# hse-medpost directory API (loopback, bearer token)
MEDPOST_API_URL=http://127.0.0.1:8113
MEDPOST_API_TOKEN=

# Cloudflare gate Worker and its shared secret
GATE_WORKER_URL=
GATE_SHARED_SECRET=

# Cloudflare Turnstile for the public "My Layar Entry Permit" lookup (keys from the Cloudflare dashboard).
# Leave both empty and the lookup is switched off. TURNSTILE_DEV=1 is for local development only.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_DEV=
# Set to 1 when the site is reached through Cloudflare, so the real visitor address is used for rate limits.
TRUST_CF_IP=
